# ---------------------------------------------------------------------------
# New client setup: copy this file, fill in every value, and add them to the
# client's Vercel project (Settings -> Environment Variables). See SETUP.md.
# The values below are EXAMPLES only. Nothing in the code falls back to them.
# NEXT_PUBLIC_* values are written into the build, so redeploy after changing one.
# ---------------------------------------------------------------------------

# --- Plan: which admin system this client gets -----------------------------
# basic = Basic property admin only. pro = Basic + Pro company management.
# Anything other than "pro" is treated as "basic".
NEXT_PUBLIC_PLAN=basic

# --- Company identity -------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME=Example Realty
# Path of the logo inside /public (see "Replacing the logo" in SETUP.md).
NEXT_PUBLIC_LOGO_PATH=/logo.png
# Optional English overrides. Leave empty to use the wording in lib/i18n/en.ts.
NEXT_PUBLIC_TAGLINE=A place for your next chapter.
NEXT_PUBLIC_ABOUT=Find your next home, workspace, or investment. Explore clear property details and speak directly with our team.
NEXT_PUBLIC_ADDRESS=Main Street, Example City, Country

# --- Brand colours (optional) ----------------------------------------------
# 6-digit hex values. Leave both empty to keep the default gold and navy palette.
# Lighter and darker shades are derived automatically.
NEXT_PUBLIC_PRIMARY_COLOR=#9e813e
NEXT_PUBLIC_SECONDARY_COLOR=#0b1f38

# --- Contact ----------------------------------------------------------------
NEXT_PUBLIC_PHONE=+10000000000
# Digits only, with country code, no plus sign.
NEXT_PUBLIC_WHATSAPP_NUMBER=10000000000
# Leave empty to hide the Instagram link.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/example
# Where property requests are delivered, and shown in the footer.
COMPANY_EMAIL=hello@example.com
# Sender shown on property request emails. Must be a sender verified in Resend.
RESEND_FROM_EMAIL=Example Realty <requests@example.com>
RESEND_API_KEY=

# --- Money and wording ------------------------------------------------------
# ISO currency code, locale used to format prices, and rent period label.
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=en-US
NEXT_PUBLIC_RENTAL_PERIOD=month

# --- Site address -----------------------------------------------------------
# Full public address with https://, used for sitemap and search results.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Database and storage (one Neon database and one Blob store per client) --
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# --- Admin login ------------------------------------------------------------
# Password for the first admin account, created on first sign-in. Use a new,
# unique password for every client. The admin's email is COMPANY_EMAIL.
ADMIN_PASSWORD=
# Random value of at least 32 characters, different for every client.
ADMIN_SESSION_SECRET=
